<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape>
            <solid android:color="@color/panel_focus" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="10dp" />
            <padding android:left="14dp" android:right="14dp" android:top="8dp" android:bottom="8dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="#3D4B61" />
            <corners android:radius="10dp" />
            <padding android:left="14dp" android:right="14dp" android:top="8dp" android:bottom="8dp" />
        </shape>
    </item>
</selector>
