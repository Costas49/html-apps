<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true">
        <shape>
            <solid android:color="@color/panel_focus" />
            <stroke android:width="3dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape>
            <solid android:color="@color/panel_focus" />
            <stroke android:width="2dp" android:color="@color/accent" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape>
            <solid android:color="@color/panel" />
            <stroke android:width="1dp" android:color="#334155" />
            <corners android:radius="14dp" />
        </shape>
    </item>
</selector>
